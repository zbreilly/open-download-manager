<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDownloadManager.ProgressWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:OpenDownloadManager">

    <Grid x:Name="Root" PointerEntered="Root_PointerEntered" PointerExited="Root_PointerExited">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20,16" Spacing="14">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="Icon" FontSize="34" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" TextTrimming="CharacterEllipsis" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="PlaceText" FontFamily="{StaticResource Mono}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" />
                    </StackPanel>
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="28">
                    <TextBlock x:Name="PercentText" FontSize="40" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Grid x:Name="Stats" ColumnSpacing="24" RowSpacing="2" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                    </Grid>
                </StackPanel>

                <TextBlock x:Name="ErrorText" FontFamily="{StaticResource Mono}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" Visibility="Collapsed" />
                <TextBlock x:Name="Verified" Text="✓ Checksum verified" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Visibility="Collapsed" />

                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock x:Name="SegTitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Faded = segment done · light edge = write position" FontSize="12" HorizontalAlignment="Right"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <local:SegmentMap x:Name="Segments" Height="26" ShowWriteHead="True" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <ListView x:Name="Connections" SelectionMode="None" MinHeight="170" MaxHeight="260"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="30" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ConnectionRow">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="86" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Number}" Style="{StaticResource Dim}" FontFamily="{StaticResource Mono}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Received}" Style="{StaticResource Num}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind State}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Speed}" Style="{StaticResource Num}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <Grid>
                            <TextBlock Text="Speed, last 60 s" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="PeakText" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Grid>
                        <local:Sparkline x:Name="Spark" Height="80" />
                        <ToggleSwitch x:Name="LimitOn" Header="Limit this download" OnContent="On" OffContent="Off" Toggled="LimitOn_Toggled" />
                        <StackPanel x:Name="LimitRow" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <TextBox x:Name="LimitBox" Width="90" KeyDown="LimitBox_KeyDown" />
                            <TextBlock Text="MB/s" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Apply" Click="ApplyLimit_Click" />
                        </StackPanel>
                        <TextBlock x:Name="LimitError" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                        <ComboBox x:Name="WhenFinished" Header="When finished" HorizontalAlignment="Stretch" SelectionChanged="WhenFinished_SelectionChanged">
                            <ComboBoxItem Content="Show notification" Tag="notify" />
                            <ComboBoxItem Content="Open file" Tag="openFile" />
                            <ComboBoxItem Content="Show in folder" Tag="openFolder" />
                            <ComboBoxItem Content="Do nothing" Tag="none" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8"
              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="HideButton" Content="Hide" Click="Hide_Click" />
            <TextBlock Grid.Column="1" x:Name="ClosingText" FontSize="12" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Grid.Column="2" x:Name="CancelButton" Content="Cancel Download" Click="Cancel_Click" />
            <Button Grid.Column="3" x:Name="ToggleButton" Style="{StaticResource AccentButtonStyle}" Click="Toggle_Click" />
            <Button Grid.Column="4" x:Name="RevealButton" Content="Show in Folder" Click="Reveal_Click" />
            <Button Grid.Column="5" x:Name="OpenButton" Content="Open" Style="{StaticResource AccentButtonStyle}" Click="Open_Click" />
        </Grid>
    </Grid>
</Window>
