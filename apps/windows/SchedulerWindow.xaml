<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDownloadManager.SchedulerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ListView x:Name="QueueList" SelectionMode="Single" SelectionChanged="QueueList_SelectionChanged" Margin="0,8,0,0" />
            <Button Grid.Row="1" Content="New Queue" Margin="12" HorizontalAlignment="Stretch" Click="NewQueue_Click" />
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="Editor" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Form" Padding="20,12,20,12" />
            </ScrollViewer>
            <TextBlock x:Name="NoQueue" Text="Select a queue" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Grid Grid.Row="1" Padding="20,12" ColumnSpacing="8"
                  BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Summary" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" IsTextSelectionEnabled="True" />
                <Button Grid.Column="1" x:Name="RevertButton" Content="Revert" Click="Revert_Click" />
                <Button Grid.Column="2" x:Name="SaveButton" Content="Save Schedule" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
