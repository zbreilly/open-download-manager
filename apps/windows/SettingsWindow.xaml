<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenDownloadManager.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="Root">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="Escape" Invoked="Escape_Invoked" />
        </Grid.KeyboardAccelerators>
        <NavigationView x:Name="Nav"
                        PaneDisplayMode="Left"
                        OpenPaneLength="220"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        IsSettingsVisible="False"
                        SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="General" Tag="general" Icon="Setting" />
                <NavigationViewItem Content="Connection" Tag="connection" Icon="Sync" />
                <NavigationViewItem Content="Browser" Tag="browser" Icon="Globe" />
                <NavigationViewItem Content="File Types" Tag="types" Icon="Document" />
                <NavigationViewItem Content="Proxy" Tag="proxy" Icon="MapDrive" />
                <NavigationViewItem Content="Notifications" Tag="notifications" Icon="Message" />
                <NavigationViewItem Content="Advanced" Tag="advanced" Icon="Repair" />
            </NavigationView.MenuItems>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Pane" Padding="24,8,24,24" MaxWidth="760" HorizontalAlignment="Left" />
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
