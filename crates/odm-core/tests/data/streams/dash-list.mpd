<?xml version="1.0"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" type="static" mediaPresentationDuration="PT6S">
  <Period>
    <AdaptationSet mimeType="audio/mp4">
      <Representation id="aud" bandwidth="64000" codecs="mp4a.40.5">
        <BaseURL>https://cdn.example/audio/track.mp4</BaseURL>
        <SegmentList timescale="1" duration="2">
          <Initialization range="0-799"/>
          <SegmentURL mediaRange="800-1799"/>
          <SegmentURL mediaRange="1800-2799"/>
          <SegmentURL media="extra.m4s"/>
        </SegmentList>
      </Representation>
    </AdaptationSet>
  </Period>
</MPD>
