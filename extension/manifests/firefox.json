{
  "manifest_version": 2,
  "name": "Open Download Manager",
  "version": "2.0.0",
  "description": "Hand downloads, links and media to Open Download Manager for faster, resumable downloading.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Open Download Manager",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "background": { "scripts": ["background.js"], "persistent": false },
  "permissions": ["downloads", "contextMenus", "storage", "alarms", "cookies", "webRequest", "tabs", "notifications", "<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "browser_specific_settings": { "gecko": { "id": "ext@opendm.app", "strict_min_version": "115.0" } }
}
