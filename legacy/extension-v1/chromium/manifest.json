{
  "manifest_version": 3,
  "name": "Open Download Manager",
  "version": "1.0.0",
  "description": "Send links, videos, audio, and images to Open Download Manager.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["capture.js"], "run_at": "document_idle" }
  ]
}
