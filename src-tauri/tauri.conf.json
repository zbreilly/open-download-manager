{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Download Manager",
  "mainBinaryName": "open-download-manager",
  "version": "0.2.0",
  "identifier": "app.opendm.desktop",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Fast, resumable, segmented downloads",
    "longDescription": "Open Download Manager accelerates downloads with multiple connections, resumes interrupted transfers, schedules queues and integrates with your browser.",
    "copyright": "© 2026 Open Download Manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../extension/dist/": "extension/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 215
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 215
        }
      }
    },
    "windows": {
      "nsis": {
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1",
          "desktop-file-utils"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3",
          "desktop-file-utils"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "odm"
        ]
      }
    }
  }
}
